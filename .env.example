# ML_SHADOW_V1 is a NIFTY-only paper engine. It contains no broker-order path
# and also refuses to start if live trading is accidentally enabled.
TRADING_ENGINE=ML_SHADOW_V1
ENABLE_LIVE_TRADING=false
TRADE_BANK_NIFTY=false
ML_SHADOW_PAPER_ENABLED=true

# Upstox credentials remain account-specific and must never be committed.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
UPSTOX_ACCESS_TOKEN=

# Nightly point-in-time training through the prior trading day.
ML_SHADOW_TRAINING_DAYS=180
ML_SHADOW_HISTORY_CALENDAR_DAYS=300
ML_SHADOW_HORIZON_CANDLES=4
ML_SHADOW_MIN_TRAINING_ROWS=1500
ML_SHADOW_MAX_MODEL_AGE_DAYS=4

# Entry rule applied after each completed 15-minute candle.
ML_SHADOW_MIN_PROBABILITY=0.70
ML_SHADOW_MIN_EXPECTED_POINTS=10
ML_SHADOW_MIN_REWARD_RISK=0.80
ML_SHADOW_MIN_DIRECTION_PROBABILITY_GAP=0.05
ML_SHADOW_OPENING_OBSERVATION_CANDLES=2
ML_SHADOW_FIRST_ENTRY_TIME=09:45
ML_SHADOW_LAST_ENTRY_TIME=14:16
ML_SHADOW_CANDLE_GRACE_SECONDS=8

# Paper option execution and monitoring. Exactly one NIFTY lot and one
# non-overlapping paper position are used; target and stop come from the model.
ML_SHADOW_MAX_OPTION_SPREAD_PERCENT=5
ML_SHADOW_NIFTY_LOT_SIZE=65
ML_SHADOW_QUOTE_MAX_AGE_SECONDS=20
ML_SHADOW_MONITOR_INTERVAL_SECONDS=2

# Shared market-data reliability settings.
UPSTOX_READ_RETRY_ATTEMPTS=3
UPSTOX_STREAM_RECENT_TICKS=300

# Optional offline replay settings. They do not affect shadow execution.
BACKTEST_CACHE_ONLY=false
BACKTEST_SLIPPAGE_BPS=8
BACKTEST_COST_PER_ORDER=25
