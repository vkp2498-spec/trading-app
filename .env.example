# Deterministic multi-index option buying. Paper is the safe local default; the AWS
# deployment role is the only supported way to turn ENABLE_LIVE_TRADING on.
TRADING_ENGINE=VAMSI_KB_INTRADAY_V1
ENABLE_LIVE_TRADING=false
TRADE_BANK_NIFTY=true
TRADE_SENSEX=true
PAPER_OBSERVATION_MODE_ENABLED=false

# Safe local default. The deployment roles set Vamsi to MAX and Ganesh to one
# lot without touching account credentials.
DEFAULT_TRADING_PROFILE=1_LOT
OPTION_CAPITAL_PER_ENTRY=1
ACCOUNT_MAX_OPTION_CAPITAL=0
ACCOUNT_MAX_LOTS_PER_ENTRY=1
MAX_LOTS_PER_ENTRY=1
MAX_CAPITAL_USE_PERCENT=95
MAX_CAPITAL_RESERVE_RUPEES=1000

# One completed outcome per day. Both profit and loss guards therefore make
# MAX_INDEX_TRADES_PER_DAY=1 explicit rather than relying on journal timing.
MAX_INDEX_TRADES_PER_DAY=1
STOP_AFTER_FIRST_PROFIT_OR_LOSS=true
STOP_AFTER_FIRST_PROFIT=true
STOP_AFTER_FIRST_LOSS=true
AFTER_FIRST_OUTCOME_MODE=stop
AFTER_FIRST_PROFIT_MODE=stop
AFTER_FIRST_LOSS_MODE=stop
ALLOW_SIMULTANEOUS_INDEX_POSITIONS=false
DAILY_PNL_GUARDS_ENABLED=false

# Index-level objectives and invalidations. Live delta converts these moves into
# selected-option premium levels after the fill is known.
NIFTY_TARGET_POINTS=30
NIFTY_STOP_POINTS=30
BANKNIFTY_TARGET_POINTS=60
BANKNIFTY_STOP_POINTS=60
SENSEX_TARGET_POINTS=40
SENSEX_STOP_POINTS=40
OPTION_DELTA_APPROXIMATION=0.50
VAMSI_KB_TARGET_POINTS=30
VAMSI_KB_STOP_POINTS=30
VAMSI_KB_NIFTY_TARGET_POINTS=30
VAMSI_KB_NIFTY_STOP_POINTS=30
VAMSI_KB_BANKNIFTY_TARGET_POINTS=60
VAMSI_KB_BANKNIFTY_STOP_POINTS=60
VAMSI_KB_SENSEX_TARGET_POINTS=40
VAMSI_KB_SENSEX_STOP_POINTS=40
VAMSI_KB_FORCE_MAX_ALLOCATION=false
VAMSI_KB_FIRST_ENTRY_TIME=09:20
VAMSI_KB_LAST_ENTRY_TIME=15:15
VAMSI_KB_OBSERVATION_FIRST_TIME=09:20
VAMSI_KB_OBSERVATION_LAST_TIME=15:27

# Weekly operator-reviewed live rule. NIFTY 50-59 may soften only the named
# research gates. BANKNIFTY and SENSEX keep scanning for the post-market audit
# but have no live-eligible score bucket this week. The adaptive planner may
# still generate shadow output, but it has no authority over live entries.
VAMSI_KB_WEEKLY_MANUAL_PLAN_ENABLED=true
VAMSI_KB_WEEKLY_PLAN_LABEL=MANUAL_NIFTY_50_59_V1
VAMSI_KB_NIFTY_LIVE_SCORE_BUCKETS=50-59
VAMSI_KB_NIFTY_LIVE_RELAXED_GATES=setup,completed_candles,breadth,option_flow
VAMSI_KB_NIFTY_MAX_RELAXED_FAILURES=4
VAMSI_KB_BANKNIFTY_LIVE_SCORE_BUCKETS=
VAMSI_KB_BANKNIFTY_LIVE_RELAXED_GATES=
VAMSI_KB_BANKNIFTY_MAX_RELAXED_FAILURES=0
VAMSI_KB_SENSEX_LIVE_SCORE_BUCKETS=
VAMSI_KB_SENSEX_LIVE_RELAXED_GATES=
VAMSI_KB_SENSEX_MAX_RELAXED_FAILURES=0
VAMSI_KB_DAILY_PLAN_ENABLED=false

# Evidence and bounded-softening thresholds. Option chain, contract quality and
# entry freshness remain mandatory under the weekly plan.
VAMSI_KB_CANDLE_GRACE_SECONDS=8
VAMSI_KB_MAX_CANDLE_AGE_MINUTES=7
VAMSI_KB_MIN_BREADTH_COVERAGE=30
VAMSI_KB_NIFTY_MIN_BREADTH_COVERAGE=30
VAMSI_KB_BANKNIFTY_MIN_BREADTH_COVERAGE=3
VAMSI_KB_SENSEX_MIN_BREADTH_COVERAGE=20
VAMSI_KB_MIN_BREADTH_SCORE=18
VAMSI_KB_ALLOW_NEUTRAL_CHAIN=false
VAMSI_KB_MIN_OPTION_VOLUME_RATIO=1.0
VAMSI_KB_MIN_OPTION_DELTA=0.40
VAMSI_KB_MAX_OPTION_DELTA=0.70
VAMSI_KB_MAX_OPTION_SPREAD_PERCENT=2.0
VAMSI_KB_MAX_ENTRY_EXTENSION_PERCENT=1.5
VAMSI_KB_BOLLINGER_REVERSAL_ENABLED=true

# Shared contract validity and broker-safety settings.
MAX_OPTION_SPREAD_PERCENT=2.0
MIN_OPTION_DELTA=0.40
MAX_OPTION_DELTA=0.70
OPTION_GREEKS_FILTER=true
OPTION_DEPTH_FILTER=false
COMPLETED_CANDLE_GRACE_SECONDS=8
BROKER_RECONCILIATION_REQUIRED=true
BROKER_PROTECTIVE_STOP_ENABLED=true
REQUIRE_HEALTHY_POSITION_MONITOR=true
POSITION_MONITOR_INTERVAL_SECONDS=2
CONCISE_TRADE_LOGS=true
ALLOW_BOT_WITH_UNTRACKED_DERIVATIVE_POSITIONS=false

# Intelligent staged protection: at 40% of the planned move lock 10%; at 60%
# lock 25%; at 80% lock 55% while leaving the runner aimed at the full target.
PROFIT_PROTECTION_ENABLED=true
PROFIT_BOOKING_TARGET_PERCENT=80
PROFIT_BOOKING_MODE=runner
PROFIT_RUNNER_LOCK_PERCENT=55
PROFIT_PROTECTION_STAGE_ONE_TRIGGER_PERCENT=40
PROFIT_PROTECTION_STAGE_ONE_LOCK_PERCENT=10
PROFIT_PROTECTION_STAGE_TWO_TRIGGER_PERCENT=60
PROFIT_PROTECTION_STAGE_TWO_LOCK_PERCENT=25

# A thesis reversal needs persistent option-chain, VWAP, 5M and 15M evidence;
# entry score changes alone can never force an exit.
VAMSI_THESIS_REVERSAL_EXIT_ENABLED=true
VAMSI_THESIS_REVERSAL_GRACE_MINUTES=5
VAMSI_THESIS_REVERSAL_MIN_COMPONENTS=3
VAMSI_THESIS_REVERSAL_CONFIRMATION_SCANS=2
VAMSI_THESIS_REVERSAL_SKIP_AFTER_TARGET_PROGRESS_PERCENT=70

# Retired ML jobs remain disabled even when live trading is enabled.
ML_SHADOW_PAPER_ENABLED=false
ML_SHADOW_LIVE_TRADING_ENABLED=false
ML_SHADOW_V2_LIVE_ENABLED=false
ML_SHADOW_FORECAST_ONLY=true
