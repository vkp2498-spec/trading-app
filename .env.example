# Select the live strategy family on this AWS instance. Both engines share the
# same monitor and square-off safety layer, but only the selected engine may
# create new entries.
TRADING_ENGINE=VAMSI

# Trade structure and exposure controls
ENABLE_LIVE_TRADING=false
CONCISE_TRADE_LOGS=true
# Safe automatic reset profile. Set MAX only when the account-level caps below
# are deliberately configured and tested.
DEFAULT_TRADING_PROFILE=1_LOT
# Independent account ceilings; zero means disabled. These still apply when a
# mobile selection or MAX profile requests a larger amount.
ACCOUNT_MAX_OPTION_CAPITAL=0
ACCOUNT_MAX_LOTS_PER_ENTRY=1
# Optional absolute caps on dynamically scaled controls; zero means disabled.
DAILY_MAX_LOSS_ABSOLUTE_CAP=0
DAILY_PROFIT_TARGET_ABSOLUTE_CAP=0
DAILY_SOFT_LOSS_ABSOLUTE_CAP=0
PEAK_PROFIT_GIVEBACK_ABSOLUTE_CAP=0
INDEX_RISK_PER_TRADE_ABSOLUTE_CAP=0
MAX_DAILY_INDEX_RISK_ABSOLUTE_CAP=0
MAX_OPEN_PORTFOLIO_RISK_ABSOLUTE_CAP=0
# Separate kill switch for mobile delivery orders. Keep false until a live
# order has been explicitly reviewed and the app confirmation flow tested.
MOBILE_LIVE_ORDERS_ENABLED=false
# Use 1 for exactly one lot. Otherwise this is the rupee allocation per entry;
# whole lots are rounded down so the expected premium value stays within it.
OPTION_CAPITAL_PER_ENTRY=1
# Optional extra hard ceiling. Use 0 for no ceiling beyond capital allocation.
MAX_LOTS_PER_ENTRY=1
# A mobile profile applies this allocation per opportunity/instrument.
# If you select 300000, NIFTY may use up to 300000, and BANKNIFTY may
# also use up to 300000 on a later trade. Only one index position is
# allowed open at a time.

# Keep allocation and the two app-selected day limits independent. The legacy
# percentage values below are ignored while this switch is false.
DYNAMIC_CAPITAL_RISK_ENABLED=false
DAILY_PROFIT_TARGET_CAPITAL_PERCENT=10
DAILY_MAX_LOSS_CAPITAL_PERCENT=15
DAILY_SOFT_LOSS_CAPITAL_PERCENT=7.5
PEAK_PROFIT_GIVEBACK_TRIGGER_CAPITAL_PERCENT=7.5
INDEX_RISK_PER_TRADE_CAPITAL_PERCENT=15
MAX_DAILY_INDEX_RISK_CAPITAL_PERCENT=15
# 17.25% accommodates the separate 15% buffer around a 15% planned-risk cap.
MAX_OPEN_PORTFOLIO_RISK_CAPITAL_PERCENT=17.25

# Ganesh/manual-trading profile only. When true, bot entries may coexist with
# an untracked manual NSE derivatives position. The bot will not manage or
# square off that manual position. Keep false for Vamsi.
ALLOW_BOT_WITH_UNTRACKED_DERIVATIVE_POSITIONS=false

# NIFTY direction, option-chain trend, OI/PCR and ATM option VWAP/volume use
# the nearest expiry. Vamsi selective/Test and Ganesh entries always buy the
# next-expiry ATM NIFTY contract. BANKNIFTY remains unchanged.
# Long option exits use underlying-index points, converted to option premium
# with the delta approximation after the actual order fill.
# Technical option-premium reward/risk gate. Trades are accepted only when the
# aligned 15M target offers at least 0.8 times the configured option risk.
NIFTY_TARGET_POINTS=30
NIFTY_STOP_POINTS=30
BANKNIFTY_TARGET_POINTS=90
BANKNIFTY_STOP_POINTS=90
# Keep the original stop fixed and exit after this percentage of the planned
# premium move has been completed. In runner mode this percentage activates a
# stronger profit lock and the position continues toward the full target.
PROFIT_BOOKING_TARGET_PERCENT=80
PROFIT_BOOKING_MODE=runner
PROFIT_RUNNER_LOCK_PERCENT=55
PROFIT_PROTECTION_ENABLED=true
PROFIT_PROTECTION_STAGE_ONE_TRIGGER_PERCENT=60
PROFIT_PROTECTION_STAGE_ONE_LOCK_PERCENT=20
PROFIT_PROTECTION_STAGE_TWO_TRIGGER_PERCENT=70
PROFIT_PROTECTION_STAGE_TWO_LOCK_PERCENT=35
# The legacy combined switch is kept for compatibility. The two specific
# switches override it, allowing another valid setup after either outcome.
STOP_AFTER_FIRST_PROFIT_OR_LOSS=false
# stop: no later entry; paper: later qualified entries are simulated and
# managed with the same target, stop-loss, trailing-stop, and exit logic.
AFTER_FIRST_OUTCOME_MODE=stop
STOP_AFTER_FIRST_PROFIT=false
STOP_AFTER_FIRST_LOSS=false
# cooldown: same-direction re-entry is allowed after MIN_REENTRY_MINUTES;
# reset: also requires a neutral/opposite signal first; off: no loss guard.
LOSS_REENTRY_MODE=cooldown
# Zero means the next scheduled five-minute signal check can qualify again.
MIN_REENTRY_MINUTES=0
OPTION_DELTA_APPROXIMATION=0.50
MIN_TECHNICAL_REWARD_RISK=0.8
MAX_ENTRY_EXTENSION_PERCENT=1.5
# At 09:00 IST the adaptive calibration job can replace this unified-score
# fallback with an evidence-backed minimum or bounded range for each index.
# Legacy VAMSI_MIN_WEIGHTED_SCORE is no longer used.
VAMSI_ADAPTIVE_SCORE_ENABLED=false
VAMSI_UNIFIED_SCORE_FALLBACK=80
# Optional inclusive disjoint static bands. When present, these override adaptive
# calibration and the fallback/maximum pair. Example: scores 50-59 or 80-89 only.
VAMSI_UNIFIED_SCORE_RANGES=80-89
# Optional inclusive upper boundary for a fixed static range. When using it,
# set VAMSI_ADAPTIVE_SCORE_ENABLED=false so the daily adaptive rule cannot replace it.
VAMSI_UNIFIED_SCORE_MAXIMUM=89
VAMSI_FIRST_ENTRY_TIME=09:15
VAMSI_LAST_ENTRY_TIME=15:15
# Fresh collection baseline. One eligible live trade is allowed each day, while
# every other score-complete setup is independently simulated in one of ten slots.
VAMSI_STATIC_COLLECTION_FIRST_ENTRY_TIME=09:15
VAMSI_STATIC_COLLECTION_LAST_ENTRY_TIME=15:15
PAPER_OBSERVATION_MODE_ENABLED=true
PAPER_OBSERVATION_FIRST_ENTRY_TIME=09:15
PAPER_OBSERVATION_LAST_ENTRY_TIME=15:15
MAX_SIMULTANEOUS_PAPER_OBSERVATIONS=10

# Exit adaptation is research-only. The 09:00 job replays qualified NIFTY BUY
# observations from the same entry window, validates them on held-out history,
# and writes proposals that are never consumed by real or paper execution.
VAMSI_ADAPTIVE_EXIT_MODE=shadow
VAMSI_ADAPTIVE_EXIT_LOOKBACK_DAYS=90
VAMSI_ADAPTIVE_EXIT_HORIZON_MINUTES=60
VAMSI_ADAPTIVE_EXIT_MIN_SAMPLES=40
VAMSI_ADAPTIVE_EXIT_MIN_TRADING_DAYS=10
VAMSI_ADAPTIVE_EXIT_VALIDATION_FRACTION=0.30
VAMSI_ADAPTIVE_EXIT_MIN_VALIDATION_SAMPLES=10
VAMSI_ADAPTIVE_EXIT_MIN_VALIDATION_PROFIT_FACTOR=1.10
VAMSI_ADAPTIVE_EXIT_MIN_REWARD_RISK=0.80
VAMSI_ADAPTIVE_EXIT_MAX_DAILY_CHANGE_PERCENT=10
VAMSI_ADAPTIVE_EXIT_TARGET_GRID=10,15,20,25,30,35,40,45
VAMSI_ADAPTIVE_EXIT_STOP_GRID=10,15,20,25,30,35,40,45

# Automatic live promotion uses prior-day non-overlapping observations only.
# A time x score cell needs 40 samples, held-out validation, and three successful
# calibrations with new evidence. After first promotion, stale/failed policy
# files suspend entries rather than silently returning to the static range.
VAMSI_AUTO_ADAPTIVE_LIVE_ENABLED=true
VAMSI_ADAPTIVE_LIVE_LOOKBACK_DAYS=90
VAMSI_ADAPTIVE_LIVE_HORIZON_MINUTES=60
VAMSI_ADAPTIVE_LIVE_MIN_SAMPLES_PER_CELL=40
VAMSI_ADAPTIVE_LIVE_MIN_TRADING_DAYS=10
VAMSI_ADAPTIVE_LIVE_VALIDATION_FRACTION=0.30
VAMSI_ADAPTIVE_LIVE_MIN_VALIDATION_SAMPLES=12
VAMSI_ADAPTIVE_LIVE_MIN_VALIDATION_PROFIT_FACTOR=1.20
VAMSI_ADAPTIVE_LIVE_MIN_REWARD_RISK=0.80
VAMSI_ADAPTIVE_LIVE_MAX_DAILY_EXIT_CHANGE_PERCENT=10
VAMSI_ADAPTIVE_LIVE_REQUIRED_CALIBRATIONS=3
VAMSI_ADAPTIVE_MAX_LIVE_TRADES_CAP=1
VAMSI_ADAPTIVE_LIVE_TARGET_GRID=10,15,20,25,30,35,40,45
VAMSI_ADAPTIVE_LIVE_STOP_GRID=10,15,20,25,30,35,40,45

# Optional second-chance path. A weakly opposite 5M candle waits for one
# completed 5M confirmation.
INDEX_WATCH_MODE_ENABLED=false
INDEX_WATCH_MODE_SHADOW_ONLY=true
INDEX_WATCH_MIN_OPTION_VOLUME_RATIO=1.20

# Inputs used by the unified market-regime and entry-structure score components.
REGIME_COMPRESSION_BB_WIDTH_PERCENT=0.18
NIFTY_REGIME_EXTREME_ATR_PERCENT=0.35
BANKNIFTY_REGIME_EXTREME_ATR_PERCENT=0.45
ENTRY_RETEST_BUFFER_ATR=0.25

# Compare ATM with the nearest one-strike-ITM option. Contract liquidity and
# validity remain hard safeguards; regime, structure, and reward/risk are scored.
INDEX_CONTRACT_SELECTION_ENABLED=true
PREFERRED_OPTION_DELTA_MIN=0.45
PREFERRED_OPTION_DELTA_MAX=0.70
MAX_OPTION_SPREAD_PERCENT=2.5
OPTION_GREEKS_FILTER=true
OPTION_DEPTH_FILTER=false
MIN_OPTION_DELTA=0.20
MAX_OPTION_DELTA=0.80

# Active Vamsi loss-reduction exit. Every completed five-minute interval combines
# high-confidence opposite option-chain direction, underlying+option VWAP weakness,
# and opposite 5M/15M structure. Three of four components must persist twice;
# a completed 15M structural break plus adverse VWAP exits immediately. The entry
# score is not consulted, and the original broker premium stop remains active.
VAMSI_THESIS_REVERSAL_EXIT_ENABLED=true
VAMSI_THESIS_REVERSAL_GRACE_MINUTES=5
VAMSI_THESIS_REVERSAL_MIN_COMPONENTS=3
VAMSI_THESIS_REVERSAL_CONFIRMATION_SCANS=2
VAMSI_THESIS_REVERSAL_SKIP_AFTER_TARGET_PROGRESS_PERCENT=70
# This legacy streamed structural stop is used only when the composite reversal
# exit above is disabled. Composite mode confirms structure on completed candles.
UNDERLYING_STRUCTURAL_STOP_ENABLED=true
STRUCTURAL_STOP_ATR_BUFFER=0.20
UNDERLYING_QUOTE_MAX_AGE_SECONDS=20
INDEX_TIME_STOP_ENABLED=true
INDEX_TIME_STOP_MINUTES=20
INDEX_TIME_STOP_MIN_PROGRESS_PERCENT=15

# Intraday participation breadth. BANKNIFTY uses its configured major banks;
# NIFTY combines equal participation with a configurable heavyweight basket.
NIFTY_BREADTH_DIRECTION_THRESHOLD=18
NIFTY_BREADTH_FULL_MOVE_PERCENT=0.50
NIFTY_BREADTH_HEAVYWEIGHTS=RELIANCE:20,HDFCBANK:18,BHARTIARTL:14,ICICIBANK:13,INFY:12,TCS:9,ITC:7,LT:7

# Shared portfolio risk layer. Increase only after computing stop distance
# x actual quantity for the selected capital allocation.
# Fixed-value fallbacks below are used for the 1-lot profile or when dynamic
# capital risk is disabled.
MAX_OPEN_PORTFOLIO_RISK=0
PORTFOLIO_RISK_BUFFER_PERCENT=15
# These are also the automatic-reset defaults for the app selectors. The app
# accepts 5000 through 30000 in increments of 5000.
DAILY_PNL_GUARDS_ENABLED=true
DAILY_PROFIT_TARGET=5000
DAILY_MAX_LOSS=5000
DAILY_SOFT_LOSS=0
DAILY_SOFT_PAUSE_MINUTES=30
DAILY_SOFT_SCORE_PENALTY=0
MAX_CONSECUTIVE_LOSSES=0
PEAK_PROFIT_GIVEBACK_TRIGGER=0
MAX_PEAK_GIVEBACK_PERCENT=50
# Index entries are controlled as a shared day budget, not one trade per
# instrument. A second trade needs a better score, especially after a loss.
MAX_INDEX_TRADES_PER_DAY=1
# When enabled, NIFTY and BANKNIFTY may each hold one selective position at the
# same time. Portfolio risk and same-direction correlation gates still apply.
ALLOW_SIMULTANEOUS_INDEX_POSITIONS=false
# Set false to prevent both Vamsi and Ganesh from opening new BANKNIFTY trades.
# Existing BANKNIFTY positions remain monitored and managed until they close.
TRADE_BANK_NIFTY=false
MAX_DAILY_INDEX_RISK=0
INDEX_RISK_PER_TRADE=0
SECOND_INDEX_TRADE_SCORE_BONUS=0
SECOND_TRADE_AFTER_LOSS_SCORE_BONUS=0
REQUIRE_SIGNAL_RESET_FOR_SAME_INDEX_REENTRY=false

# Correlation controls. Same-direction NIFTY/BANKNIFTY entries require both
# scores to clear this threshold.
SAME_DIRECTION_INDEX_MIN_SCORE=80
MAX_SAME_DIRECTION_POSITIONS=2
ALLOW_PROFIT_LOCKED_CORRELATED_POSITIONS=true

# A neutral chain contributes zero evidence. It may be overridden only by an
# unusually strong, aligned technical setup that clears these higher scores.
NIFTY_NEUTRAL_CHAIN_MIN_SCORE=80
BANKNIFTY_NEUTRAL_CHAIN_MIN_SCORE=75

MONITOR_SENTIMENT_INTERVAL_SECONDS=60
MONITOR_BROKER_CACHE_SECONDS=2
POSITION_MONITOR_INTERVAL_SECONDS=2
REQUIRE_HEALTHY_POSITION_MONITOR=true
MONITOR_HEALTH_MAX_AGE_SECONDS=20
MONITOR_FAILURE_THRESHOLD=3
BROKER_PROTECTIVE_STOP_ENABLED=true
BROKER_RECONCILIATION_REQUIRED=true
MARKET_PROTECTION_PERCENT=3
UPSTOX_READ_RETRY_ATTEMPTS=3
UPSTOX_STREAM_RECENT_TICKS=300

# Ganesh NIFTY/BANKNIFTY opening-gap engine. It can trade either a confirmed
# reversal or a completed-candle gap continuation, but never both lanes for the
# same symbol/day. GANESH_GAP_MAX_TRADES_PER_DAY is one combined account cap.
GANESH_GAP_MODE=FAITHFUL
GANESH_GAP_LIVE_TRADING=false
GANESH_STRATEGY_START_TIME=09:30
GANESH_LAST_ENTRY_TIME=15:25
GANESH_MIN_GAP_PERCENT=0.20
GANESH_ENTRY_CONFIRMATION_SCANS=2
GANESH_EXIT_CONFIRMATION_SCANS=2
GANESH_COLOUR_NEUTRAL_BUFFER_POINTS=0
GANESH_MIN_REVERSAL_POINTS=0
GANESH_BB_PERIOD=20
GANESH_BB_STDDEV=2
GANESH_MIN_TARGET_POINTS=15
GANESH_LOTS_PER_ENTRY=1
GANESH_OPTION_STOP_PERCENT=20
GANESH_MAX_RISK_PER_TRADE=0
GANESH_OPTION_DELTA_APPROXIMATION=0.50
GANESH_MAX_OPTION_SPREAD_PERCENT=2.5
GANESH_GAP_MAX_TRADES_PER_DAY=1
GANESH_DATA_MAX_AGE_SECONDS=120
GANESH_DATA_STALE_EXIT_SECONDS=60
GANESH_NIFTY_STRIKE_INTERVAL=50
GANESH_BANKNIFTY_STRIKE_INTERVAL=100

# Gap-continuation lane. The first completed 15M candle must accept the gap and
# a completed 5M candle must break the opening range. Near-expiry ATM option
# VWAP/volume, constituent breadth, option chain and institutional context then
# form the 100-point score. Execution still buys the next-expiry ATM option.
GANESH_CONTINUATION_ENABLED=true
GANESH_OPENING_RANGE_MINUTES=15
GANESH_CONTINUATION_START_TIME=09:35
GANESH_CONTINUATION_LAST_ENTRY_TIME=11:30
GANESH_CONTINUATION_MIN_SCORE=75
GANESH_CONTINUATION_MIN_OPTION_VOLUME_RATIO=1.20
GANESH_CONTINUATION_MAX_EXTENSION_RANGE=0.75
GANESH_CONTINUATION_RETEST_TOLERANCE_RANGE=0.10
GANESH_CONTINUATION_INVALIDATION_BUFFER_POINTS=0

# Optional enhancements; FAITHFUL mode ignores these gates. Switch the mode to
# ENHANCED only after reviewing a meaningful paper-trading sample.
GANESH_REQUIRE_VOLUME_CONFIRMATION=false
GANESH_REQUIRE_BB_DIRECTION=false
GANESH_REQUIRE_MIN_REWARD_RISK=false
GANESH_SPOT_STOP_POINTS=15
GANESH_MIN_REWARD_RISK=1.20

# Offline historical replay. These do not affect live trading.
BACKTEST_PORTFOLIO_MODE=live
BACKTEST_SLIPPAGE_BPS=8
BACKTEST_COST_PER_ORDER=25

# Weekly delivery-stock research screener. By default it scans the explicit
# NIFTY 50 universe instead of relying on arbitrary instrument-file ordering.
# Set a comma-separated list to customize, or ALL only for deliberate broad scans.
STOCK_SCREENER_SYMBOLS=
STOCK_SCREENER_MAX_SYMBOLS=50
STOCK_SCREENER_WORKERS=4
STOCK_SCREENER_MIN_PRICE=50
STOCK_SCREENER_MIN_AVG_TURNOVER=5000000
STOCK_SCREENER_MIN_SCORE=60
STOCK_SCREENER_MIN_REWARD_RISK=1.50
STOCK_SCREENER_INVESTMENT_AMOUNT=100000
STOCK_SCREENER_MAX_SIGNAL_AGE_HOURS=96
STOCK_SCREENER_POSITION_REVIEW_MAX_AGE_HOURS=18
