# Trade structure and exposure controls
ENABLE_LIVE_TRADING=false
ALLOW_NAKED_OPTION_SELLING=false
CHECK_SHORT_MARGIN_IN_DRY_RUN=false
MAX_LOTS_PER_ENTRY=1
NIFTY_LOTS=1
BANKNIFTY_LOTS=1

# Ganesh/manual-trading profile only. When true, bot entries may coexist with
# an untracked manual NSE derivatives position. The bot will not manage or
# square off that manual position. Keep false for Vamsi.
ALLOW_BOT_WITH_UNTRACKED_DERIVATIVE_POSITIONS=false

# A sell candidate must be materially stronger than a valid buy candidate.
SHORT_MIN_WEIGHTED_SCORE=80
SHORT_SCORE_ADVANTAGE=5
SHORT_MIN_VOLUME_RATIO=0.8

# Keep this part of available margin unused after the broker margin estimate.
SHORT_MARGIN_BUFFER_PERCENT=20

# Existing percentage controls apply to both BUY and SELL positions. For SELL,
# target is below entry premium and stop is above entry premium.
NORMAL_TARGET_PERCENT=10
NORMAL_STOP_PERCENT=7.5
CAUTIOUS_TARGET_PERCENT=6
CAUTIOUS_STOP_PERCENT=5

# NIFTY 50 stock-futures fallback. Index options always have first priority.
# Start with live trading disabled and inspect data/stock_scanner_status.json.
ENABLE_STOCK_FUTURES_SCANNER=false
ENABLE_STOCK_FUTURES_LIVE_TRADING=false
CHECK_STOCK_MARGIN_IN_DRY_RUN=false
STOCK_FUTURES_MAX_CANDIDATES=8
STOCK_FUTURES_MIN_SCORE=80
STOCK_FUTURES_MIN_VOLUME_RATIO=1.20
STOCK_FUTURES_MAX_SPREAD_PERCENT=0.20
STOCK_FUTURES_MIN_REWARD_RISK=1.20
STOCK_FUTURES_MIN_DAYS_TO_EXPIRY=2
STOCK_FUTURES_MARGIN_BUFFER_PERCENT=20
STOCK_FUTURES_MAX_RISK_PER_TRADE=5000
STOCK_FUTURES_MIN_EXPECTED_PROFIT=5000
STOCK_FUTURES_OPENING_REVERSION=true
STOCK_FUTURES_OPENING_MIN_SCORE=70
STOCK_FUTURES_OPENING_MIN_REWARD_RISK=1.00
STOCK_FUTURES_DEPTH_DOMINANCE_PERCENT=0.65
MONITOR_SENTIMENT_INTERVAL_SECONDS=60

# Optional comma-separated override. Leave blank to use the built-in NIFTY 50 list.
NIFTY50_FUTURES_SYMBOLS=

# Offline historical replay. These do not affect live trading.
BACKTEST_PORTFOLIO_MODE=live
BACKTEST_SLIPPAGE_BPS=8
BACKTEST_COST_PER_ORDER=25
